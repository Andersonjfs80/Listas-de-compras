{
  "AppName": "app-api-autenticacao",
  "PathBase": "/app-api-autenticacao",
  "Core_Http_Settings": {
    "GlobalHeaders": [],
    "RetryCount": 3,
    "BaseDelaySeconds": 2,
    "FailureThreshold": 5,
    "DurationOfBreakSeconds": 30,
    "DesativarSegurancaSsl": false
  },
  "AutenticacaoSettings": {
    "UrlBackend": "http://app-backend-autenticacao:7001/app-backend-autenticacao"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Security": {
    "TokenProvider": "JWT",
    "SecretKey": "EssaEhUmaChaveMestraSuperSecretaParaOProjetoListasDeCompras2026!",
    "FixedEncryptionKey": "ChaveFixaParaCriptografiaDeCamposBackendCompativel123!",
    "ExpirationInMinutes": 5,
    "RefreshTokenExpirationInMinutes": 5,
    "PasswordExpirationDays": 90,
    "PasswordWarningDays": 15,
    "PasswordHistoryLimit": 5,
    "EnableBodyEncryption": true,
    "EnableFieldEncryption": true,
    "SessionKeyExpirationMinutes": 15
  },
  "AllowedHosts": "*",
  "KafkaSettings": {
    "BootstrapServers": "kafka:29092",
    "Topic": "topic-listas-compras",
    "Enabled": true,
    "LogAutomaticoHttp": true,
    "LogConsole": true,
    "OfuscarCampos": {
      "Request": [
        "senha",
        "password",
        "token"
      ],
      "Response": [
        "senha",
        "password",
        "token"
      ]
    }
  }
}