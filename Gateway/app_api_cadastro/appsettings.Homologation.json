{
  "AppName": "app-api-cadastro",
  "PathBase": "/app-api-cadastro",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConfigurationSettings": {
    "UrlBackendProduto": "http://app-backend-produto:6001/app-backend-produto",
    "UrlBackendListaCompras": "http://app-backend-lista-compras:6002/app-backend-lista-compras",
    "UrlBackendOferta": "http://app-backend-lista-compras:6002/app-backend-lista-compras"
  },
  "KafkaSettings": {
    "BootstrapServers": "kafka:29092",
    "Topic": "topic-listas-compras",
    "Enabled": true,
    "LogAutomaticoHttp": true,
    "LogConsole": true,
    "OfuscarCampos": {
      "Request": [
        "senha",
        "password",
        "token"
      ],
      "Response": [
        "senha",
        "password",
        "token"
      ]
    }
  },
  "Core_Http_Settings": {
    "DesativarSegurancaSsl": true
  },
  "Security": {
    "SecretKey": "EssaEhUmaChaveMestraSuperSecretaParaOProjetoListasDeCompras2026!",
    "FixedEncryptionKey": "ChaveFixaParaCriptografiaDeCamposBackendCompativel123!",
    "EnableBodyEncryption": true,
    "EnableFieldEncryption": true
  }
}